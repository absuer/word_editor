# =============================================
# 智能客服系统 环境变量
# 复制为 .env 后填入实际值
# =============================================

# --- 大模型 API（DeepSeek OpenAI-compatible endpoint）---
ANTHROPIC_AUTH_TOKEN=your_api_key_here
ANTHROPIC_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_MODEL=deepseek-chat

# --- OnlyOffice Document Server ---
# 本地 Docker 部署: http://localhost:8080
# 远程服务器: https://docs.yourcompany.com
# ONLYOFFICE_API_URL=http://localhost:8080/web-apps/apps/api/documents/api.js
# ONLYOFFICE_JWT_SECRET=your_jwt_secret_here
